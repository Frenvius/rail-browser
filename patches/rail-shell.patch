+void WebUIBrowserClientView::OnMouseEvent(ui::MouseEvent* event) {
+#if BUILDFLAG(IS_WIN)
+  const bool is_hover_event = event->type() == ui::EventType::kMouseMoved ||
+                              event->type() == ui::EventType::kMouseEntered;
+  const bool is_left_press = event->type() == ui::EventType::kMousePressed &&
+                             event->IsOnlyLeftMouseButton();
+  if (!is_hover_event && !is_left_press) {
+    return;
+  }
+
+  HWND hwnd = views::HWNDForWidget(GetWidget());
+  if (!hwnd) {
+    return;
+  }
+
+  const LPARAM cursor_position = static_cast<LPARAM>(::GetMessagePos());
+  const int component = static_cast<int>(
+      ::SendMessage(hwnd, WM_NCHITTEST, 0, cursor_position));
+
+  if (is_hover_event) {
+    if (wchar_t* cursor = ResizeCursorForComponent(component)) {
+      ::SetCursor(::LoadCursor(nullptr, cursor));
+    }
+    return;
+  }
+
+  const int resize_command = ResizeCommandForComponent(component);
+  if (component != HTCAPTION && resize_command == 0) {
+    return;
+  }
+
+  event->StopPropagation();
+  ::ReleaseCapture();
+  if (component == HTCAPTION) {
+    if (event->GetClickCount() == 2) {
+      ::PostMessage(hwnd, WM_SYSCOMMAND,
+                    GetWidget()->IsMaximized() ? SC_RESTORE : SC_MAXIMIZE, 0);
+      return;
+    }
+    ::PostMessage(hwnd, WM_SYSCOMMAND, SC_MOVE | HTCAPTION, cursor_position);
+    return;
+  }
+
+  ::SetCursor(
+      ::LoadCursor(nullptr, ResizeCursorForComponent(component)));
+  ::PostMessage(hwnd, WM_SYSCOMMAND, SC_SIZE | resize_command, cursor_position);
+#endif
+}
+
 int WebUIBrowserClientView::NonClientHitTest(const gfx::Point& point) {
+  // The frameless window has no native frame to grab, so the client area
+  // itself reports the resize edges.
+  const int resize_component = GetResizeComponent(point);
+  if (resize_component != HTNOWHERE) {
+    return resize_component;
+  }
+
   if (draggable_region_.contains(point.x(), point.y())) {
     return HTCAPTION;
   }
   return ClientView::NonClientHitTest(point);
 }
 
+int WebUIBrowserClientView::GetResizeComponent(const gfx::Point& point) const {
+  const views::Widget* widget = GetWidget();
+  if (!widget || !widget->widget_delegate()->CanResize() ||
+      widget->IsMaximized() || widget->IsFullscreen()) {
+    return HTNOWHERE;
+  }
+
+  constexpr int kResizeBorder = 6;
+  constexpr int kResizeCorner = 16;
+
+  bool in_top = point.y() < kResizeBorder;
+  bool in_bottom = point.y() >= height() - kResizeBorder;
+  bool in_left = point.x() < kResizeBorder;
+  bool in_right = point.x() >= width() - kResizeBorder;
+  if (!in_top && !in_bottom && !in_left && !in_right) {
+    return HTNOWHERE;
+  }
+
+  in_top |= point.y() < kResizeCorner;
+  in_left |= point.x() < kResizeCorner;
+  in_right |= point.x() >= width() - kResizeCorner;
+
+  if (in_top) {
+    if (in_left) {
+      return HTTOPLEFT;
+    }
+    return in_right ? HTTOPRIGHT : HTTOP;
+  }
+  if (in_bottom) {
+    if (in_left) {
+      return HTBOTTOMLEFT;
+    }
+    return in_right ? HTBOTTOMRIGHT : HTBOTTOM;
+  }
+  return in_left ? HTLEFT : HTRIGHT;
+}
