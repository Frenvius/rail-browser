+
+  private runMenuCommand_(detail: TabCommandDetail) {
+    const {command, target, spaceId, windowId, folderId} = detail;
+    const targets = this.commandTargets_(command, target);
+    if (command === 'new-window') {
+      this.moveToNewWindow_(targets);
+      return;
+    }
+    if (command === 'mini-window') {
+      this.moveToMiniWindow_(targets);
+      return;
+    }
+    if (command === 'move-to-window') {
+      this.moveToWindow_(targets, windowId);
+      return;
+    }
+    for (const one of targets) {
+      this.runTabCommand(command, one, spaceId, folderId);
+    }
+  }
+
+  private commandTargets_(command: TabCommand, target: TabMenuTarget):
+      TabMenuTarget[] {
+    if (!actsOnSelection(command) || this.selectedIds_.length < 2 ||
+        !this.selection_.has(target.id)) {
+      return [target];
+    }
+    return this.selectedIds_.map(id => this.targetFor(id))
+        .filter((one): one is TabMenuTarget => one !== null);
+  }
+
+  private async moveToNewWindow_(targets: TabMenuTarget[]) {
+    const ids = targets.map(one => one.tabId)
+                    .filter((id): id is string => id !== null);
+    if (!ids.length) {
+      return;
+    }
+    this.collapseSelection_(this.activeTab_);
+    this.fire('tab-closing', {ids});
+    await browserProxyFactory.getInstance().handler.moveTabsToNewWindow(ids);
+  }
+
+  private async moveToMiniWindow_(targets: TabMenuTarget[]) {
+    const ids = targets.map(one => one.tabId)
+                    .filter((id): id is string => id !== null);
+    if (!ids.length) {
+      return;
+    }
+    this.collapseSelection_(this.activeTab_);
+    this.fire('tab-closing', {ids});
+    await browserProxyFactory.getInstance().handler.moveTabsToMiniWindow(ids);
+  }
+
+  private async moveToWindow_(targets: TabMenuTarget[], windowId: number) {
+    const ids = targets.map(one => one.tabId)
+                    .filter((id): id is string => id !== null);
+    if (!ids.length) {
+      return;
+    }
+    this.collapseSelection_(this.activeTab_);
+    this.fire('tab-closing', {ids});
+    await browserProxyFactory.getInstance().handler.moveTabsToWindow(
+        windowId, ids);
+  }
+
+  runTabCommand(
+      command: TabCommand, target: TabMenuTarget, spaceId = '',
+      folderId = '') {
+    switch (command) {
+      case 'new-folder':
+        this.fileInFolder_(
+            target, this.folders_.create(this.activeSpace_, 'New Folder').id,
+            true);
+        break;
+      case 'add-to-folder':
+        this.fileInFolder_(target, folderId, false);
+        break;
+      case 'remove-from-folder':
+        this.fileInFolder_(target, '', false);
+        break;
+      case 'move-to-space':
+        this.moveToSpace_(target, spaceId);
+        break;
+      case 'route-to-space':
+        this.routeToSpace_(target);
+        break;
+      case 'copy-link':
+        navigator.clipboard.writeText(target.url).then(
+            () => showToast('Copied URL', 'link'));
+        break;
+      case 'duplicate':
+        this.duplicateTab_(target);
+        break;
+      case 'new-tab-below':
+        this.newTabBelow_(target);
+        break;
+      case 'new-window':
+        this.moveToNewWindow_([target]);
+        break;
+      case 'mini-window':
+        this.moveToMiniWindow_([target]);
+        break;
+      case 'sleep':
+        if (target.tabId) {
+          this.sleepTab_(target.tabId);
+        }
+        break;
+      case 'mute':
+        if (target.tabId) {
+          this.toggleMute_(target.tabId);
+        }
+        break;
+      case 'pin':
+        this.pinTab_(target.id);
+        break;
+      case 'unpin':
+        this.unpinTab_(target.id);
+        break;
+      case 'replace-pinned-url':
+        this.replacePinnedUrl_(target.id);
+        break;
+      case 'favorite':
+        this.toggleFavorite_(target);
+        break;
+      case 'close':
+        this.closeTarget_(target.id);
+        break;
+      case 'close-others':
+        this.closeMany_(
+            this.looseTabIds_().filter(other => other !== target.id));
+        break;
+      case 'close-right':
+        this.closeToRight_(target.id);
+        break;
+    }
+  }
+
+  private closeToRight_(targetId: string) {
+    const loose = this.looseTabIds_();
+    const index = loose.indexOf(targetId);
+    // A pinned target sits outside the loose order, so there is no "right" of
+    // it to close.
+    if (index >= 0) {
+      this.closeMany_(loose.slice(index + 1));
+    }
+  }
+
+  // Pinned rows are left alone: closing them is what the pin was meant to
+  // prevent, and a dormant row has no tab to close in the first place.
+  private closeMany_(ids: string[]) {
+    this.archiveRows_(ids);
+    const live = ids.filter(id => !this.dropRow_(id));
+    if (live.length) {
+      this.closeTabs_(live);
+      return;
+    }
+    if (ids.length) {
+      this.refreshSections_();
+    }
+  }
+
+  protected looseTabCount_(): number {
+    return this.looseTabIds_().length;
+  }
+
+  protected onClearTabsClick_() {
+    this.closeMany_(this.looseTabIds_());
+  }
