+void WebUIBrowserPageHandler::ListProfiles(ListProfilesCallback callback) {
+  std::vector<webui_browser::mojom::RailProfilePtr> profiles;
+  for (const rail::ProfileEntry& entry : rail::ListProfiles(GetBrowser())) {
+    profiles.push_back(ToMojoProfile(entry));
+  }
+  std::move(callback).Run(std::move(profiles));
+}
