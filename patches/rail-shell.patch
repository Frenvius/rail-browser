+      if (this.selection_.toggle(id, this.activeTab_)) {
+        this.activateTab(id);
+      }
+      this.syncSelection_();
+      return;
+    }
+    this.collapseSelection_(id);
+    this.pendingBelow_ = '';
+    if (!this.spaces_.relatedRows(this.activeTab_, id)) {
+      this.forgetOpeners_(this.spaces_.activeId);
+    }
+    this.activateTab(id);
+  }
+
+  private rowOrder_(): string[] {
+    return [
+      ...this.favoriteRows_.map(row => row.item.id),
+      ...this.pinnedRows_.map(row => row.item.id),
+      ...this.looseTabIds_(),
+    ];
+  }
+
+  private syncSelection_() {
+    const order = this.rowOrder_();
+    this.selection_.retain(order);
+    this.selectedIds_ =
+        this.selection_.size > 1 ? this.selection_.ids(order) : [];
+  }
+
+  protected isSelected_(id: string): boolean {
