+void WebUIBrowserWindow::OpenRailCommandBar(bool new_tab_mode,
+                                            bool select_all) {
+  if (!command_bubble_) {
+    command_bubble_ = std::make_unique<rail::RailCommandBubble>(this);
+  }
+  std::string text;
+  if (!new_tab_mode) {
+    content::WebContents* active =
+        browser_->GetTabStripModel()->GetActiveWebContents();
+    if (active) {
+      text = active->GetVisibleURL().spec();
+    }
+  }
+  command_bubble_->Show(text, select_all, new_tab_mode);
+}
