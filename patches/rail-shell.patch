+void WebUIBrowserWindow::SetSystemBackdrop(
+    webui_browser::mojom::SystemBackdropSettingsPtr settings) {
+#if BUILDFLAG(IS_WIN)
+  if (!backdrop_controller_ || !settings) {
+    return;
+  }
+  rail::SystemBackdropConfig config;
+  switch (settings->material) {
+    case webui_browser::mojom::SystemBackdropMaterial::kMica:
+      config.material = rail::SystemBackdropMaterial::kMica;
+      break;
+    case webui_browser::mojom::SystemBackdropMaterial::kMicaAlt:
+      config.material = rail::SystemBackdropMaterial::kMicaAlt;
+      break;
+    case webui_browser::mojom::SystemBackdropMaterial::kAcrylic:
+      config.material = rail::SystemBackdropMaterial::kAcrylic;
+      break;
+    case webui_browser::mojom::SystemBackdropMaterial::kAcrylicThin:
+      config.material = rail::SystemBackdropMaterial::kAcrylicThin;
+      break;
+  }
+  config.tint_color = settings->tint_color;
+  config.fallback_color = settings->fallback_color;
+  config.tint_opacity = settings->tint_opacity;
+  config.luminosity_opacity = settings->luminosity_opacity;
+  backdrop_controller_->SetConfig(config);
+#endif
+}
