+void WebUIBrowserPageHandler::SetActiveProfile(
+    const std::string& profile_id,
+    SetActiveProfileCallback callback) {
+  rail::ResolveProfile(
+      GetBrowser(), profile_id,
+      base::BindOnce(
+          [](base::WeakPtr<WebUIBrowserUI> controller,
+             SetActiveProfileCallback callback, Profile* profile) {
+            if (controller) {
+              controller->SetActiveProfile(profile);
+            }
+            std::move(callback).Run();
+          },
+          controller_ ? controller_->GetWeakPtr()
+                      : base::WeakPtr<WebUIBrowserUI>(),
+          std::move(callback)));
+}
+
+void WebUIBrowserPageHandler::CreateDownloadsHandler(
+    const std::string& profile_id,
+    mojo::ScopedMessagePipeHandle page_pipe,
+    mojo::ScopedMessagePipeHandle handler_pipe) {
+  mojo::PendingRemote<downloads::mojom::Page> page(std::move(page_pipe), 0u);
+  mojo::PendingReceiver<downloads::mojom::PageHandler> handler(
+      std::move(handler_pipe));
+  rail::ResolveProfile(
+      GetBrowser(), profile_id,
+      base::BindOnce(
+          [](base::WeakPtr<WebUIBrowserUI> controller,
+             mojo::PendingRemote<downloads::mojom::Page> page,
+             mojo::PendingReceiver<downloads::mojom::PageHandler> handler,
+             Profile* profile) {
+            if (controller && profile) {
+              controller->downloads().CreatePageHandler(
+                  profile, std::move(page), std::move(handler));
+            }
+          },
+          controller_ ? controller_->GetWeakPtr()
+                      : base::WeakPtr<WebUIBrowserUI>(),
+          std::move(page), std::move(handler)));
+}
