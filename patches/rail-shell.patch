+
+  private saveGroupAsFolder_(id: string) {
+    const group = this.tidyGroups_.byId(id);
+    if (!group) {
+      return;
+    }
+    const folder = this.folders_.create(group.space, group.name);
+    for (const key of this.spaces_.keysInGroup(group.id)) {
+      const entry = this.entryFor_(key) ?? this.pinTab_(key);
+      if (entry) {
+        this.pinnedTabs_.setFolder(entry.key, folder.id);
+      }
+    }
+    this.nativeGroups_.release(group.id);
+    this.tidyGroups_.remove(group.id);
+    this.refreshSections_();
+  }
+
+  private closeGroup_(id: string) {
+    const keys = this.spaces_.keysInGroup(id);
+    this.nativeGroups_.release(id);
+    this.closeMany_(keys);
+    this.tidyGroups_.remove(id);
+    this.refreshSections_();
+  }
+
+  private ungroupGroup_(id: string) {
+    this.ungroupNative_(id);
+    this.spaces_.clearGroup(id);
+    this.tidyGroups_.remove(id);
+    this.refreshSections_();
+  }
+
+  private async flashTidyError_() {
+    this.tidyError_ = true;
+    await new Promise(resolve => setTimeout(resolve, 1600));
+    this.tidyError_ = false;
+  }
+
+  protected async onTidyTabsClick_() {
+    if (this.tidyBusy_) {
+      return;
+    }
+    const spaceId = this.activeSpace_;
+    const tabs: TidyTab[] = [];
+    for (const id of this.looseTabIds_()) {
+      const row = this.spaces_.rowFor(id);
+      if (row && !isNewTabUrl(row.url)) {
+        tabs.push({id, title: row.title, url: row.url});
+      }
+    }
+    if (tabs.length < 2) {
+      return;
+    }
+    const groups = this.tidyGroups_.in(spaceId).map(
+        group => ({id: group.id, name: group.name}));
+    this.tidyBusy_ = true;
+    this.tidyError_ = false;
+    let response: string|null = null;
+    try {
+      ({response} =
+           await browserProxyFactory.getInstance().handler.organizeTabs(
+               buildPrompt(tabs, groups)));
+    } catch (e) {
+      response = null;
+    } finally {
+      this.tidyBusy_ = false;
+    }
+    const plans = response ? parsePlan(response, tabs, groups) : [];
+    if (!plans.length) {
+      this.flashTidyError_();
+      return;
+    }
+    this.applyTidyPlan_(spaceId, plans);
+  }
+
+  private applyTidyPlan_(spaceId: string, plans: TidyGroupPlan[]) {
+    const grouped = new Set<string>();
+    const kept = new Set<string>();
+    const ordered: string[] = [];
+    plans.sort(
+        (one, other) => Number(isOtherGroup(one)) - Number(isOtherGroup(other)));
+    for (const plan of plans) {
+      const group = plan.id ? this.tidyGroups_.byId(plan.id) :
+                              this.tidyGroups_.create(spaceId, plan.name);
+      if (!group) {
+        continue;
+      }
+      kept.add(group.id);
+      for (const key of plan.keys) {
+        this.spaces_.setGroup(key, group.id);
+        grouped.add(key);
+        ordered.push(key);
+      }
+    }
+    this.spaces_.reorder(spaceId, ordered);
+    for (const id of this.looseTabIds_()) {
+      if (!grouped.has(id)) {
+        this.spaces_.setGroup(id, '');
+      }
+    }
+    for (const group of this.tidyGroups_.in(spaceId)) {
+      if (!kept.has(group.id)) {
+        this.tidyGroups_.remove(group.id);
+      }
+    }
+    this.refreshSections_();
+  }
+
+  private pinTab_(tabId: string, refresh = true): PinnedEntry|undefined {
+    const sleeping = this.spaces_.dormantByKey(tabId);
+    if (sleeping) {
+      const entry = this.pinnedTabs_.pinDormant(sleeping, sleeping.space);
+      this.spaces_.drop(tabId);
+      if (refresh) {
+        this.refreshSections_();
+      }
+      return entry;
+    }
+    const item = this.findItem_<TabItem>(tabId, 'tab');
+    if (!item) {
+      return undefined;
+    }
+    const entry =
+        this.pinnedTabs_.pin(item.tabData, this.spaces_.spaceOf(tabId));
+    if (refresh) {
+      this.refreshSections_();
+    }
+    return entry;
+  }
+
+  private exportSpaceToFolder_(sourceId: string, destinationId: string) {
+    const source = this.spaces_.byId(sourceId);
+    if (!source || sourceId === destinationId ||
+        !this.spaces_.byId(destinationId)) {
+      return;
+    }
+    const rows = [
+      ...this.spaces_.rowsIn(sourceId)
+          .filter(row => !isNewTabUrl(row.url))
+          .map(({key, url, title, favicon}) => ({key, url, title, favicon})),
+      ...this.pinnedTabs_.entriesIn(sourceId)
+          .filter(entry => !entry.tabId)
+          .map(({key, url, title, favicon}) => ({key, url, title, favicon})),
+    ];
+    if (!rows.length) {
+      return;
+    }
+    const folder = this.folders_.create(destinationId, source.name);
+    for (const row of rows) {
+      const entry = this.pinnedTabs_.pinDormant(row, destinationId);
+      this.pinnedTabs_.setFolder(entry.key, folder.id);
+    }
+    this.refreshSections_();
+  }
+
+  private fileInFolder_(
+      target: TabMenuTarget, folderId: string, rename: boolean) {
+    const entry = this.entryFor_(target.id) ?? this.pinTab_(target.id);
+    if (!entry) {
+      if (folderId) {
+        this.folders_.remove(folderId);
+      }
+      return;
+    }
+    if (isFavorites(entry.space)) {
+      this.pinnedTabs_.moveTo(entry.key, this.activeSpace_);
+    }
+    this.pinnedTabs_.setFolder(entry.key, folderId);
+    this.refreshSections_();
+    if (rename) {
+      this.startFolderRename_(folderId);
+    }
+  }
+
+  private async startFolderRename_(id: string) {
+    this.editingFolder_ = id;
+    await this.updateComplete;
+    const input = this.shadowRoot.querySelector<HTMLInputElement>(
+        '.folder-name-input');
+    input?.focus();
+    input?.select();
+  }
+
+  protected onFolderClick_(e: Event) {
+    if (this.dragDelegate_.consumeSuppressedClick()) {
+      return;
+    }
+    const id = (e.currentTarget as HTMLElement).dataset['folder'] ?? '';
+    this.folders_.toggle(id);
+    this.refreshSections_();
+  }
+
+  protected onFolderContextmenu_(e: MouseEvent) {
+    e.preventDefault();
+    const id = (e.currentTarget as HTMLElement).dataset['folder'] ?? '';
+    this.openFolderMenu_(id, child => this.startFolderRename_(child));
+  }
+
+  private openFolderMenu_(id: string, rename: (id: string) => void) {
+    const folder = this.folders_.byId(id);
+    if (!folder) {
+      return;
+    }
+    openFolderMenu(folder.name, (command: FolderCommand) => {
+      if (command === 'rename-folder') {
+        rename(id);
+        return;
+      }
+      if (command === 'new-subfolder') {
+        const child = this.folders_.create(folder.space, 'New Folder');
+        this.folders_.setParent(child.id, id);
+        if (!folder.expanded) {
+          this.folders_.toggle(id);
+        }
+        this.refreshSections_();
+        void this.updateComplete.then(() => rename(child.id));
+        return;
+      }
+      this.folders_.deleteTree(id, this.pinnedTabs_, key => this.closeTarget_(key));
+      this.refreshSections_();
+    });
+  }
+
+  private fileOnBoard_(id: string, spaceId: string, folderId: string) {
+    const entry = this.entryFor_(id) ?? this.pinTab_(id, false);
+    if (!entry) {
+      return;
+    }
+    if (entry.space !== spaceId) {
+      const target = this.targetFor(entry.key);
+      if (target) {
+        this.moveToSpace_(target, spaceId);
+      }
+    }
+    this.pinnedTabs_.setFolder(entry.key, folderId);
+    this.refreshSections_();
+  }
+
+  private groupOnBoard_(id: string, spaceId: string, groupId: string): string {
+    const rowId = this.entryFor_(id) ? this.unpinTab_(id) : id;
+    const row = rowId ? this.spaces_.rowFor(rowId) : undefined;
+    if (!row) {
+      return '';
+    }
+    if (row.space !== spaceId) {
+      const target = this.targetFor(row.tabId || row.key);
+      if (target) {
+        this.moveToSpace_(target, spaceId);
+      }
+    }
+    this.regroup_(row.key, groupId);
+    return row.key;
+  }
+
+  private regroup_(key: string, groupId: string) {
+    const previous = this.spaces_.rowFor(key)?.group ?? '';
+    this.spaces_.setGroup(key, groupId);
+    const group = this.tidyGroups_.byId(groupId);
+    if (group && !group.expanded) {
+      this.toggleTidyGroup_(group.id);
+    }
+    if (previous && previous !== groupId &&
+        !this.spaces_.keysInGroup(previous).length) {
+      this.tidyGroups_.remove(previous);
+    }
+    this.refreshSections_();
+  }
+
+  private moveGroupToSpace_(groupId: string, spaceId: string) {
+    const group = this.tidyGroups_.byId(groupId);
+    if (!group || group.space === spaceId) {
+      return;
+    }
+    const ids = this.spaces_.keysInGroup(groupId);
+    const keys = ids.map(id => this.spaces_.rowFor(id)!.key);
+    for (const id of ids) {
+      const target = this.targetFor(id);
+      if (target) {
+        this.moveToSpace_(target, spaceId);
+      }
+    }
+    this.tidyGroups_.moveTo(groupId, spaceId);
+    for (const key of keys) {
+      if (this.spaces_.rowFor(key)?.space === spaceId) {
+        this.spaces_.setGroup(key, groupId);
+      }
+    }
+    this.refreshSections_();
+  }
+
+  protected onFolderNameClick_(e: Event) {
+    e.stopPropagation();
+  }
+
+  protected onFolderNameKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      (e.target as HTMLInputElement).blur();
+    } else if (e.key === 'Escape') {
+      this.editingFolder_ = '';
+    }
+  }
+
+  protected onFolderNameBlur_(e: Event) {
+    const input = e.target as HTMLInputElement;
+    this.folders_.rename(this.editingFolder_, input.value.trim());
+    this.editingFolder_ = '';
+    this.refreshSections_();
+  }
+
+  protected groupFavicon_(section: TidySection): string {
+    const first = section.items[0];
+    return first?.type === 'tab' ? first.tabData.favicon.dataUrl : '';
+  }
+
+  protected folderHasActive_(section: FolderSection): boolean {
+    return !section.folder.expanded &&
+        section.rows.some(row => row.item.id === this.activeTab_);
+  }
+
+  protected visiblePinnedEntries_() {
+    return visiblePinnedLayout(this.pinnedEntries_, row => row.item.id === this.activeTab_);
+  }
+
+  protected folderRows_(section: FolderSection): PinnedRow[] {
+    return section.folder.expanded ?
+        section.rows :
+        section.rows.filter(row => row.item.id === this.activeTab_);
+  }
+
+  private toggleFavorite_(target: TabMenuTarget) {
+    const entry = this.entryFor_(target.id) ?? this.pinTab_(target.id);
+    if (!entry) {
+      return;
+    }
+    this.pinnedTabs_.moveTo(
+        entry.key,
+        isFavorites(entry.space) ?
+            this.spaces_.activeId :
+            favoritesKey(this.spaces_.profileOf(this.spaces_.activeId)));
+    this.refreshSections_();
+  }
+
+  // A pinned row and the tab behind it move together, so a row never ends up
+  // in one space while its tab answers to another.
+  private moveToSpace_(target: TabMenuTarget, spaceId: string) {
+    if (this.spaces_.moveDormant(target.id, spaceId)) {
+      this.refreshSections_();
+      return;
+    }
+    const entry = this.entryFor_(target.id);
+    if (entry) {
+      this.pinnedTabs_.moveTo(entry.key, spaceId);
+    }
+    const tabId = entry ? entry.tabId : target.id;
+    if (tabId) {
+      const wasActive = tabId === this.activeTab_;
+      const rehome = this.spaces_.profileOf(this.spaces_.spaceOf(tabId)) !==
+          this.spaces_.profileOf(spaceId);
+      if (entry) {
+        this.spaces_.assignPinned(tabId, spaceId, target.url);
+      } else {
+        this.spaces_.assign(tabId, spaceId, target.url);
+      }
+      if (rehome) {
+        this.reprofile_(tabId, spaceId, entry?.key ?? '');
+      } else if (wasActive) {
+        this.focusSpace_();
