+void ReplyWithTab(WebUIBrowserPageHandler::CreateTabInProfileCallback callback,
+                  content::WebContents* contents) {
+  tabs::TabInterface* tab =
+      contents ? tabs::TabInterface::GetFromContents(contents) : nullptr;
+  std::move(callback).Run(
+      tab ? std::make_optional(
+                tabs_api::NodeId::FromTabHandle(tab->GetHandle()))
+          : std::nullopt);
+}
+
+void ReplyWithProfile(WebUIBrowserPageHandler::CreateProfileCallback callback,
+                      std::optional<rail::ProfileEntry> entry) {
+  std::move(callback).Run(entry ? ToMojoProfile(*entry) : nullptr);
+}
