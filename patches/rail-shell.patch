+  }
+
+  protected async onTabContextMenu_(
+      e: CustomEvent<TabMenuTarget&{x: number, y: number}>) {
+    const {id} = e.detail;
+    const target = this.targetFor(id);
+    if (!target) {
+      return;
+    }
+    if (!this.selection_.has(id)) {
+      this.collapseSelection_(id);
+    }
+    target.count = this.selectedIds_.length > 1 ? this.selectedIds_.length : 1;
+    if (target.tabId) {
+      const {muted} = await browserProxyFactory.getInstance().handler.getTabMuted(
+          target.tabId);
+      target.muted = muted;
+    }
+    const {windows} =
+        await browserProxyFactory.getInstance().handler.listWindows();
+    openTabMenu(
+        {
+          target,
+          spaces: this.spaceRows_,
+          activeSpace: this.activeSpace_,
+          windows,
+          folders: this.folders_.in(this.activeSpace_),
+        },
+        detail => {
+          this.runMenuCommand_(detail);
+          this.fire<TabCommandDetail>('rail-tab-command', detail);
+        });
