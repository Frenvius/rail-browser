module rail_settings.mojom;

struct SettingsProfile {
  string id;
  string name;
};

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

struct SearchEngine {
  string id;
  string name;
};

struct SiteRoute {
  string domain;
  string path;
  string query;
  string space_id;
  bool enabled;
  bool from_ai;
};

struct PlannedRoute {
  string site;
  string space_id;
};

struct ProfileDetail {
  string name;
  array<SearchEngine> search_engines;
  string search_engine_id;
  bool search_suggestions;
};

enum UpdateStatus {
  kUnavailable,
  kIdle,
  kChecking,
  kDownloading,
  kUpToDate,
  kReady,
  kFailed,
};

interface PageHandler {
  ListProfiles() => (array<SettingsProfile> profiles);

  GetSidebarState() => (string value);

  CreateProfile(string name) => (SettingsProfile? profile);

  GetProfileDetail(string id) => (ProfileDetail? detail);

  RenameProfile(string id, string name);

  DeleteProfile(string id);

  SetSearchEngine(string id, string engine_id);

  SetSearchSuggestions(string id, bool enabled);

  OpenSearchSettings(string id);

  GetOrganizeSettings() => (bool has_key, string model, bool assistant_enabled,
                            bool tidy_enabled);

  SetAssistantEnabled(bool enabled);

  SetTidyEnabled(bool enabled);

  SetOpenRouterKey(string key);

  SetOrganizeModel(string model);

  GetSidebarIconsOnly() => (bool icons_only);

  SetSidebarIconsOnly(bool icons_only);

  GetThemedTitlebar() => (bool themed);

  SetThemedTitlebar(bool themed);

  GetGroupOpenedLinks() => (bool grouped);

  SetGroupOpenedLinks(bool grouped);

  GetReopenMiniWindows() => (bool reopen);

  SetReopenMiniWindows(bool reopen);

  GetTrailDepth() => (int32 depth);

  SetTrailDepth(int32 depth);

  GetTabSleep() => (int32 minutes, array<string> exceptions,
                    map<string, int32> archive_hours);

  SetTabSleepMinutes(int32 minutes);

  SetTabSleepExceptions(array<string> exceptions);

  SetTabArchiveHours(string id, int32 hours);

  GetSiteRoutes() => (array<SiteRoute> routes);

  AddSiteRoute(string site, string space_id) => (array<SiteRoute>? routes);

  SetSiteRoutes(array<SiteRoute> routes);

  EditSiteRoute(uint32 index, string site) => (array<SiteRoute>? routes);

  GetSpaceVisits() => (map<string, map<string, int32>> visits);

  GetSiteFavicon(string site, string profile_id) => (string? data_url);

  PlanSiteRoutes(string prompt) => (string? response);

  ApplyPlannedRoutes(array<PlannedRoute> routes) => (array<SiteRoute>? routes);

  GetVersions() => (string rail, string chromium);

  GetUpdateStatus() => (UpdateStatus status, string? version);

  CheckForUpdates();

  ApplyUpdate();

  OpenUrl(string url);

  Close();
};

interface Page {
  OnProfilesChanged();

  OnUpdateStatusChanged(UpdateStatus status, string? version);

  OnShowSection(string section);
};
