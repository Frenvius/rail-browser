module rail_command.mojom;

import "components/browser_apis/tab_strip/tab_strip_api_types.mojom";

struct CommandContext {
  bool has_tab;
  bool pinned;
  bool favorite;
  bool named;
  bool has_others;
  bool has_right;
  string space_color;
  bool profile_changed;
  array<tabs_api.mojom.NodeId> profile_tabs;
};

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

interface PageHandler {
  Ready(int32 height);

  RunCommand(string id);

  Close();
};

interface Page {
  Open(string text,
       bool select_all,
       bool new_tab_mode,
       int32 width,
       CommandContext context);
};
