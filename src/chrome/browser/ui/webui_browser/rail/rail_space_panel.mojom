module rail_space_panel.mojom;

import "chrome/browser/ui/webui_browser/browser.mojom";

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

interface PageHandler {
  Ready(int32 height);

  Restyle(webui_browser.mojom.SpaceStyle style);

  SetSystemBackdrop(webui_browser.mojom.SystemBackdropSettings settings);

  CreateProfile(string name);

  Close();
};

interface Page {
  Open(webui_browser.mojom.SpacePanelRequest request);
};
