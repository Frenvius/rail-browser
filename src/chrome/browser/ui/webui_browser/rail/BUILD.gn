import("//build/buildflag_header.gni")

source_set("media_features") {
  sources = [ "rail_media_features.h" ]
  public_deps = [
    "//base",
    "//third_party/blink/public/common",
  ]
}

source_set("auto_pip") {
  sources = [
    "rail_auto_pip.cc",
    "rail_auto_pip.h",
    "rail_media_prefs.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/prefs",
    "//content/public/browser",
    "//services/media_session/public/mojom",
    "//ui/gfx/geometry",
  ]
}

source_set("pip_controls") {
  sources = [ "rail_pip_controls.h" ]
  inputs = [ "rail_forward_30.icon" ]
  public_deps = [
    "//base",
    "//ui/gfx",
  ]
}

source_set("push") {
  sources = [
    "rail_gcm_profile_service.cc",
    "rail_gcm_profile_service.h",
    "rail_push_background.h",
    "rail_push_driver.cc",
    "rail_push_driver.h",
    "rail_push_socket.cc",
    "rail_push_socket.h",
    "rail_push_store.cc",
    "rail_push_store.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/gcm_driver",
    "//components/pref_registry",
    "//components/prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

declare_args() {
  rail_version = ""
}

buildflag_header("buildflags") {
  header = "rail_buildflags.h"
  flags = [ "RAIL_VERSION=\"$rail_version\"" ]
}
