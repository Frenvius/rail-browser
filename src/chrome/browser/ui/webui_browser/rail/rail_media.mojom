module rail_media.mojom;

import "components/browser_apis/tab_strip/tab_strip_api_types.mojom";

enum Action {
  kPlay,
  kPause,
  kPrevious,
  kNext,
  kMute,
  kActivate,
  kDismiss,
};

struct State {
  tabs_api.mojom.NodeId tab;
  bool playing;
  bool controllable;
  bool muted;
  bool active;
  bool dismissed;
  bool can_play;
  bool can_pause;
  bool can_previous;
  bool can_next;
  uint32 last_played;
  string title;
  string artist;
  string source;
  string artwork;
  string favicon;
};
